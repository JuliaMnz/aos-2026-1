# Mensagem de boas vindas
MESSAGE=uma mensagem qualquer que irá aparecer no console do servidor

# Conexão com banco de dados (NeonDB)
DATABASE_URL=postgresql://USER:PASSWORD@SERVER/DATABASE_NAME?sslmode=verify-full&channel_binding=require

# Sincronização do banco (true para resetar, false para manter)
ERASE_DATABASE_ON_SYNC=false

# Segurança e Autenticação (JWT)
JWT_SECRET=sua_chave_secreta_aqui
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d